#!/bin/zsh
# x/x
# Çalıştır: uep  (komut adı uep olarak kalır)

UEP_HOME="${0:A:h}"
# Kayıtların yeri: git ile indirildiyse kendi klasörü, Homebrew ile kurulduysa ~/.x-x
if [[ -z $UEP_DATA ]]; then
  if [[ -d $UEP_HOME/.git ]]; then UEP_DATA="$UEP_HOME"; else UEP_DATA="$HOME/.x-x"; fi
fi
[[ ${LC_ALL:-${LC_CTYPE:-$LANG}} == *UTF-8* ]] || export LC_ALL=en_US.UTF-8

for UEP_MOD in i18n ui security startup config system virus update report leftovers; do
  source "$UEP_HOME/lib/$UEP_MOD.zsh" || { print -r -- "x/x: cannot load lib/$UEP_MOD.zsh"; exit 1; }
done

uep_exit() {
  print -rn -- "${C_RESET}"$'\e[?25h'
  print
  exit 0
}
trap uep_exit INT TERM

mkdir -p "$UEP_DATA/state" "$UEP_DATA/reports"

# dil: kayıtlıysa onu kullan, değilse ilk açılışta sor
i18n_load
if [[ -z $UEP_LANG ]]; then
  if [[ -n $UEP_DEFAULT_LANG ]]; then UEP_LANG=$UEP_DEFAULT_LANG; i18n_save
  else ui_lang_pick
  fi
fi

[[ -n $UEP_NOSPLASH ]] || ui_splash

# yüklü uygulama listesini arka planda güncelle (sonradan silinenleri bilmek için)
( lo_bg_inventory ) >/dev/null 2>&1 &
UEP_BG=$!

while true; do
  ui_menu
  ui_key
  case $REPLY in
    1) sec_check ;;
    2) st_check ;;
    3) cf_check ;;
    4) sys_check ;;
    5) vr_menu ;;
    6) qr_menu ;;
    7) up_check ;;
    8) rp_full ;;
    9) lo_menu ;;
    l|L) ui_lang_toggle ;;
    0|q|Q)
      ui_clear
      print -r -- "  ${C_B2}memento mori${C_RESET}"
      print
      exit 0 ;;
  esac
done
