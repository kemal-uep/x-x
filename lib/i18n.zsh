# x/x — dil desteği (TR / EN)
# Metinler kodda Türkçe yazılıdır. İngilizce seçiliyse aşağıdaki sözlükten karşılığı gösterilir.
# Sözlükte olmayan metin (dosya adı, program adı vb.) olduğu gibi kalır.

UEP_LANG=""
typeset -gA UEP_EN

i18n_load() { # kayıtlı dili oku (yoksa boş kalır -> ilk açılışta sorulur)
  local f="$UEP_DATA/state/lang"
  UEP_LANG=""
  [[ -r $f ]] && UEP_LANG=$(<"$f")
  [[ $UEP_LANG == (tr|en) ]] || UEP_LANG=""
  return 0
}

i18n_save() { mkdir -p "$UEP_DATA/state"; print -r -- "$UEP_LANG" > "$UEP_DATA/state/lang"; }

# T "Türkçe metin" -> seçili dildeki metin
T() {
  if [[ $UEP_LANG == en ]] && (( ${+UEP_EN[$1]} )); then print -rn -- "${UEP_EN[$1]}"
  else print -rn -- "$1"
  fi
}

# TF "biçim %s" değer... -> çevrilmiş biçimle printf
TF() {
  local f=$1; shift
  [[ $UEP_LANG == en ]] && (( ${+UEP_EN[$f]} )) && f=${UEP_EN[$f]}
  printf -- "$f" "$@"
}

# değişkeni yerinde çevir (fork'suz): i18n_var label
i18n_var() {
  [[ $UEP_LANG == en ]] || return 0
  local __v=${(P)1}
  (( ${+UEP_EN[$__v]} )) && typeset -g "$1"="${UEP_EN[$__v]}"
  return 0
}

